{
  "$schema": "project-design-dna/v1",
  "project": "[TEACHER NAME] Tuition Website",
  "design_system": {
    "color": {
      "mode": "warm-light-with-dark-chapters",
      "dominant": "#F4F0E6",
      "surface": "#FFFDF8",
      "text": "#17211B",
      "primary": "#1C5B4E",
      "primary_dark": "#16483E",
      "editorial_accent": "#8D4029",
      "focus_accent": "#C58A18",
      "rule": "#D7D0C2",
      "distribution": "75/18/7",
      "gradient_policy": "no generic gradients; one approved brand-colored wave interlude only"
    },
    "typography": {
      "display_family": "Source Serif 4 Variable",
      "ui_family": "Manrope Variable",
      "display_character": "editorial, warm, authoritative, moderate contrast",
      "body_character": "modern, legible, practical",
      "hero_scale": "clamp(4.5rem, 6.3vw, 7rem)",
      "body_scale": "1rem",
      "body_line_height": 1.6,
      "headline_tracking": "-0.055em",
      "numeric_style": "tabular lining numerals"
    },
    "spacing": {
      "base_unit_px": 4,
      "scale_px": [4, 8, 12, 16, 24, 32, 48, 64, 88, 96, 128, 176],
      "desktop_section_range_px": [100, 144],
      "mobile_section_range_px": [64, 88],
      "density": "spacious editorial with compact factual bands"
    },
    "layout": {
      "desktop_columns": 12,
      "tablet_columns": 8,
      "mobile_columns": 4,
      "max_width_px": 1360,
      "desktop_gutter_px": 24,
      "composition": "asymmetric but grid-bound",
      "text_measure_characters": [58, 70]
    },
    "shape": {
      "primary": "sharp editorial geometry",
      "control_radius_px": [0, 8],
      "media_radius_max_px": 12,
      "border": "1px quiet construction rules",
      "shadow": "rare, low-opacity, context-only",
      "motifs": ["paper", "ink", "margin note", "construction line", "annotation circle"]
    },
    "components": {
      "header": "fixed compacting editorial navigation",
      "hero": "portrait-led asymmetric editorial composition",
      "button": "rectangular, verb-first, restrained press scale",
      "cards": "exception rather than default",
      "form": "persistent labels, underlined fields, in-place feedback",
      "faq": "ruled editorial disclosure",
      "learning_process": "connected line and stateful explanation panel"
    },
    "motion": {
      "engine": "Motion.dev for component state; GSAP ScrollTrigger for one pinned editorial sequence; CSS for micro feedback; OGL for one lazy-loaded gradient-wave interlude",
      "verbs": ["draw", "reveal", "connect", "confirm", "settle"],
      "enter_easing": "cubic-bezier(.23, 1, .32, 1)",
      "move_easing": "cubic-bezier(.77, 0, .175, 1)",
      "micro_duration_ms": [100, 180],
      "control_duration_ms": [160, 240],
      "editorial_duration_ms": [320, 720],
      "stagger_ms": [40, 80],
      "properties": ["transform", "opacity", "SVG stroke-dashoffset"],
      "reduced_motion": "remove translation and looping; preserve immediate state and short opacity cues"
    }
  },
  "design_style": {
    "mood": ["trustworthy", "intelligent", "warm", "calm", "attentive"],
    "visual_language": "premium academic editorial with human documentary emphasis",
    "composition_strategy": "large serif statements balanced by practical sans-serif facts and marginal annotations",
    "imagery": "authentic teacher photography with negative space and real teaching details",
    "interaction_feel": "measured, responsive, explanatory, never theatrical",
    "brand_voice": "specific, encouraging, adult, uninflated",
    "audience_balance": "parent confidence first; student comfort second"
  },
  "visual_effects": {
    "approved": [
      "masked word reveal",
      "SVG path drawing",
      "short grouped in-view choreography",
      "spring active-navigation marker",
      "animated tab/progress connection",
      "in-place form confirmation",
      "subtle media hover settle"
    ],
    "conditional": [
      "one authored SVG learning diagram",
      "light paper grain or dot texture",
      "photography mask reveal",
      "one brand-colored GradientWaves WebGL interlude with static fallback"
    ],
    "forbidden": [
      "WebGL outside the approved wave interlude",
      "Three.js",
      "Spline",
      "additional shader backgrounds",
      "aurora gradients",
      "particles",
      "cursor trails",
      "magnetic navigation",
      "continuous marquee",
      "scroll hijacking",
      "excessive parallax",
      "spotlight cards",
      "glassmorphism grids"
    ]
  },
  "responsive": {
    "mobile": "content-first single column; facts before portrait; no hover dependency",
    "tablet": "8-column re-composition; diagrams may wrap into two rows",
    "desktop": "12-column asymmetric editorial composition",
    "large_desktop": "increase outer whitespace rather than headline size"
  },
  "accessibility": {
    "target": "WCAG 2.2 AA",
    "normal_text_contrast": "4.5:1 minimum",
    "preferred_touch_target_px": 44,
    "requirements": [
      "semantic landmarks",
      "logical heading hierarchy",
      "visible focus",
      "keyboard-operable interactive process",
      "persistent form labels",
      "reduced-motion support",
      "static equivalents for animated meaning"
    ]
  },
  "content_integrity": {
    "verified_claims_only": true,
    "never_invent": [
      "qualifications",
      "results",
      "student counts",
      "school name",
      "location",
      "awards",
      "testimonials",
      "boards",
      "affiliations"
    ],
    "experience_rule": "Tuition and school experience remain separate and approximate. Never combine the figures."
  }
}
